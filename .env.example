# Copy to .env and change every secret. Never commit .env.
POSTGRES_USER=foodagent
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=foodagent
DATABASE_URL=postgresql+psycopg://foodagent:change-me-db-password@db:5432/foodagent

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_REFRESH_SECRET=

ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional: foodAgent works without it (rule-based explanations are used).
LLM_API_KEY=

SIMULATOR_ENABLED=true
SIMULATOR_INTERVAL_SECONDS=90

# --- Onboarding / account security ---
# Protected first-admin setup: a create-organization request that presents this code is activated as ADMIN immediately.
# Leave empty to require platform approval instead (python -m app.manage approve-admin <email>). Min 24 chars in production.
FIRST_ADMIN_SETUP_TOKEN=
# Base URL used to build invitation links shown to admins.
APP_URL=http://localhost:3000
# Demo quick-login (/auth/demo-accounts). Always disabled when ENVIRONMENT=production.
DEMO_LOGIN_ENABLED=true
INVITATION_EXPIRY_DAYS=7
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_REGISTER_PER_MINUTE=5
MAX_FAILED_LOGINS=8

# --- Gemini AI assistant (backend only; never prefix with NEXT_PUBLIC_) ---
# Get a key in Google AI Studio (https://aistudio.google.com/apikey). The assistant is disabled until both values are set.
GEMINI_API_KEY=your_gemini_api_key_here
# A Flash model ID available to your key (see the model list in AI Studio / https://ai.google.dev/gemini-api/docs/models)
GEMINI_MODEL=gemini-3.1-flash-lite
